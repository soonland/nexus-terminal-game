From 324ceb5baaa767e7bd41be8b427a5743cdb1bf3c Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Fri, 31 Jul 2026 02:40:49 +0000
Subject: [PATCH 2/2] fix: export named HTTP methods instead of default for
 Vercel Functions

The previous commit used 'export default handle(app)' per route file,
which vercel dev warns about: a default export returning a Response is
only recognized at the single consolidated-app entry point (app.ts /
index.ts / server.ts under project root or src/), not for arbitrary
per-route files under api/. For those, Vercel expects either the legacy
(req, res) signature or named exports per HTTP method.

Export the same handle(app)-wrapped handler under GET/POST/PUT/PATCH/
DELETE/OPTIONS/HEAD so every method actually reaches our Hono app and
its app.all('*', ...) 405 fallback runs (matching prior behavior),
rather than Vercel's own generic 405/404.
---
 api/aria.ts             | 17 ++++++++++++++++-
 api/camera-feed.ts      | 17 ++++++++++++++++-
 api/file.ts             | 17 ++++++++++++++++-
 api/node-description.ts | 17 ++++++++++++++++-
 api/sentinel.ts         | 17 ++++++++++++++++-
 api/world.ts            | 17 ++++++++++++++++-
 6 files changed, 96 insertions(+), 6 deletions(-)

diff --git a/api/aria.ts b/api/aria.ts
index 0a8b2c3..f1bdb34 100644
--- a/api/aria.ts
+++ b/api/aria.ts
@@ -311,4 +311,19 @@ app.post('*', async c => {
 
 app.all('*', c => c.json({ error: 'Method not allowed' }, 405));
 
-export default handle(app);
+// Vercel Functions expect either the legacy (req, res) signature or named
+// exports per HTTP method returning a Response — a default export that
+// returns a Response is only recognized for the single consolidated-app
+// entry point (app.ts/index.ts/server.ts), not for per-route files like
+// this one. Export the same Hono-wrapped handler under every method so
+// our app-level 405 fallback (above) is what runs, not Vercel's own.
+const vercelHandler = handle(app);
+export {
+  vercelHandler as GET,
+  vercelHandler as POST,
+  vercelHandler as PUT,
+  vercelHandler as PATCH,
+  vercelHandler as DELETE,
+  vercelHandler as OPTIONS,
+  vercelHandler as HEAD,
+};
